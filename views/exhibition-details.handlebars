<h1>{{exhibition.name}}</h1>
<p><strong>Year:</strong> {{exhibition.year}}</p>
<p><strong>Location:</strong> {{exhibition.location}}</p>
<p><strong>Type:</strong> {{exhibition.type}}</p>
<p>{{exhibition.description}}</p>
<img class="detail-img" src="{{exhibition.image_url}}" alt="{{exhibition.name}}" />

<hr />

{{#if session.isAdmin}}
  <form method="POST" action="/exhibitions/update/{{exhibition.id}}" enctype="multipart/form-data">
    <label>Name
      <input name="name" value="{{exhibition.name}}" required />
    </label><br />
    <label>Location
      <input name="location" value="{{exhibition.location}}" required />
    </label><br />
    <label>Year
      <input name="year" type="number" value="{{exhibition.year}}" required />
    </label><br />
    <label>Type
      <input name="type" value="{{exhibition.type}}" required />
    </label><br />
    <label>Description
      <input name="description" value="{{exhibition.description}}" required />
    </label><br />
    <label>Image URL
      <input name="image_url" value="{{exhibition.image_url}}" />
       </label>
    <label> or Upload
      <input type="file" name="image" />
    </label><br />
    <button type="submit">Update</button>
  </form>

  <form method="POST" action="/exhibitions/delete/{{exhibition.id}}">
    <button type="submit">Delete</button>
  </form>
{{/if}}

<h2>Artists in this Exhibition</h2>
<ul>
  {{#each artists}}
    <li>
      <h3>{{name}}</h3>
      <p><strong>Nationality:</strong> {{nationality}}</p>
      <p><strong>Age:</strong> {{age}}</p>
      <p><strong>Famous Work:</strong> {{famous_work}}</p>
      <img src="{{image_url}}" alt="{{name}}" />
    </li>
  {{/each}}
</ul>

{{#unless artists}}
  <p>No artists found for this exhibition.</p>
{{/unless}}

<h2>Artworks in this Exhibition</h2>
{{#if session.isAdmin}}
  <h3>Add artwork</h3>
  <form method="POST" action="/exhibition/{{exhibition.id}}/artworks" enctype="multipart/form-data">
    <label>Title <input name="title" required /></label><br />
    <label>Medium <input name="medium" /></label><br />
    <label>Rewords <input name="rewords" /></label><br />
    <label>Image URL <input name="image_url" placeholder="/images/... or https://..." /></label>
    <label> or Upload <input type="file" name="image" /></label><br />
    <button type="submit">Create</button>
  </form>
{{/if}}
<ul>
  {{#each artworks}}
    <li>
      <h3>{{title}}</h3>
      <p><strong>Medium:</strong> {{medium}}</p>
      <p>{{rewords}}</p>
      {{#if ../session.isAdmin}}
        <form method="POST" action="/artworks/{{id}}/update" enctype="multipart/form-data">
          <input type="hidden" name="exhibition_id" value="{{../exhibition.id}}" />
          <label>Title <input name="title" value="{{title}}" required /></label>
          <label>Medium <input name="medium" value="{{medium}}" /></label>
          <label>Rewords <input name="rewords" value="{{rewords}}" /></label>
          <label>Image URL <input name="image_url" value="{{image_url}}" /></label>
          <label> or Upload <input type="file" name="image" /></label>
          <button type="submit">Update</button>
        </form>
        <form method="POST" action="/artworks/{{id}}/delete" style="margin-top:6px">
          <input type="hidden" name="exhibition_id" value="{{../exhibition.id}}" />
          <button type="submit">Delete</button>
        </form>
      {{/if}}
    </li>
  {{/each}}
</ul>

{{#unless artworks}}
  <p>No artworks found for this exhibition.</p>
{{/unless}}

<a href="/exhibitions">← Back to all exhibitions</a>