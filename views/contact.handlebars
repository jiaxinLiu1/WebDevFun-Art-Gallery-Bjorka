<div class="contact-container">
  <h1 class="shop-title">Contact Us</h1>

  <form class="contact-form" method="POST" action="/contact/submit">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" placeholder="Your name" required />

    <label for="email">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="Your email"
      required
    />

    <label for="subject">Subject</label>
    <input
      type="text"
      id="subject"
      name="subject"
      placeholder="Subject"
      required
    />

    <label for="message">Message</label>
    <textarea
      id="message"
      name="message"
      placeholder="Your message"
      rows="6"
      required
    ></textarea>

    <button type="submit">Send Message</button>
  </form>

  <div class="contact-info">
    <p>Email: gallery@bjorka.se</p>
    <p>Phone: (weekdays 10 am-2 pm): + 46 123 45 678</p>
    <p>Address: 123 Art Street, Stockholm, Sweden</p>
  </div>
</div>