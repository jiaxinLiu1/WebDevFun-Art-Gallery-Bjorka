<section id="shop-detail" class="section">
  <div class="container">
    <div class="product-detail">
      <img src="{{item.image_url}}" alt="{{item.name}}" />
      <div class="product-info">
        <h2>{{item.name}}</h2>
        <p>Category: {{item.category}}</p>
        <p>Price: ${{item.price}}</p>
      </div>
    </div>

    <div class="reviews">
      <h3>User Reviews</h3>
      {{#if reviews.length}}
        <ul>
          {{#each reviews}}
            <li>
              <strong>{{this.username}}:</strong>
              {{this.comment}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p>No reviews</p>
      {{/if}}
    </div>
  </div>
</section>